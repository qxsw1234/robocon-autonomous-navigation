<?xml version="1.0"?>
<!--
  diy_nav_gazebo / worlds/complex_world.world
  ===========================================
  阶段 6 复杂世界：16×12 m（x∈[-8,8]，y∈[-6,6]）。
  纯 SDF 基本几何体（box/cylinder），零 Fuel 依赖。

  结构：
    - 四周外墙（高 1.2 m）
    - 中央 16 m 长走廊（y∈[-0.75,0.75]）：长直走廊使激光特征高度相似，
      是对 SLAM 回环检测的刻意考验
    - 上排房间 R1/R2（被 x=0 分隔墙分开）、下排房间 R3/R4（被 x=2.5 分隔墙分开）
    - 门口：R1 宽 0.8 m（窄通道考验） / R2 宽 1.2 m / R3、R4 宽 1.0 m
    - U 形障碍（R2）、L 形障碍（R4）、遮挡大箱体（R3）、多独立箱体
    - 走廊+房间构成多条回环路线
    - 危险区：红色地面标记（无碰撞）；起点区：绿色标记（无碰撞）
    - 6 个目标区：黄色薄圆柱标记（无碰撞，不挡激光）

  6 组材质（世界元素）：地面=浅灰  墙=蓝灰  障碍=橙  危险区=红  起点=绿  目标=黄

  推荐初始位姿：x=0 y=0 yaw=0（起点区，走廊中心）
  推荐目标点：G1(6.5,4.5)  G2(-6.5,4.5)  G3(-6.5,-4.5)  G4(6.5,-4.5)
              G5(-7.5,0)   G6(7.5,0)
-->
<sdf version="1.6">
  <world name="complex_world">

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ================= 地面（浅灰） ================= -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>24 20</size></plane>
          </geometry>
