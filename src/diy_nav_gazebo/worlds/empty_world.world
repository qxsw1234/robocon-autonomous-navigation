<?xml version="1.0"?>
<!--
  diy_nav_gazebo / worlds/empty_world.world
  =========================================
  阶段 5 基础空世界（SDF 1.6，Gazebo Classic 11）。

  设计要点：
    - 不依赖 models.gazebosim.org（该服务已停用），ground_plane 与光照全部内联；
    - ground_plane 用静态平面模型（visual + collision 齐备），尺寸 100×100 m；
    - 方向光模拟太阳（带阴影），保证 RViz/Gazebo 画面可见；
    - 无任何障碍物：用于阶段 5 运动测试与后续通用仿真底稿。
-->
<sdf version="1.6">
  <world name="empty_world">

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 默认物理参数（ODE）：步长 1 ms、实时因子 1.0，保证差速驱动稳定 -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

  </world>
</sdf>
