<?xml version="1.0"?>
<!--
  diy_nav_bot / gazebo_plugins.xacro
  ==================================
  阶段 5：Gazebo Classic 11 插件与物理属性实现。
  阶段 4.5 曾以空壳形式声明接口，本节内容与之逐项对应：

    1. 差速驱动插件（模型级）→ /cmd_vel /odom + odom → base_footprint TF
    2. 关节状态发布插件     → /joint_states（左右驱动轮）
    3. 2D 激光雷达          → /scan（720 samples / 10 Hz / 0.12~8.0 m / σ=0.01）
    4. IMU                  → /imu（50 Hz）
    5. 接触摩擦：轮 mu=1.0，前万向轮 mu=0（fixed caster 零摩擦才能原地旋转）
    6. 材质映射：6 种 RGBA 颜色 → Gazebo 内置材质

  约定：
    - odom → base_footprint 全项目唯一 TF 来源（publish_wheel_tf=false，
      车轮 TF 由 robot_state_publisher 从 /joint_states 发布，不重复）
    - 全部数值可调参数集中在本文件顶部属性 + config/gazebo_params.yaml（两处同步）
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       可调参数（修改时同步 config/gazebo_params.yaml）
       ============================================================ -->
  <xacro:property name="diff_drive_update_rate"   value="30"/>
  <xacro:property name="max_wheel_torque"         value="20"/>
  <xacro:property name="max_wheel_acceleration"   value="5.0"/>
  <xacro:property name="joint_state_update_rate"  value="30"/>
  <xacro:property name="laser_update_rate"        value="10"/>
  <xacro:property name="laser_samples"            value="720"/>
  <xacro:property name="laser_min_range"          value="0.12"/>
  <xacro:property name="laser_max_range"          value="8.0"/>
  <xacro:property name="laser_noise_stddev"       value="0.01"/>
  <xacro:property name="imu_update_rate"          value="50"/>

  <!-- ============================================================
       1. 差速驱动插件
       ============================================================ -->
  <gazebo>
    <plugin name="diy_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <remapping>cmd_vel:=cmd_vel</remapping>
      </ros>
      <!-- 左/右关节声明（REP-103：+y 为左）：left_joint=left_wheel_joint(y=+0.18)
           插件公式 vl=(v−ω·d/2)/r、vr=(v+ω·d/2)/r：+ω 时左轮减速（内侧）、
           右轮加速（外侧）→ 逆时针（yaw 增大），与 REP-103 一致。 -->
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_diameter>${2 * wheel_radius}</wheel_diameter>
      <max_wheel_torque>${max_wheel_torque}</max_wheel_torque>
      <max_wheel_acceleration>${max_wheel_acceleration}</max_wheel_acceleration>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <update_rate>${diff_drive_update_rate}</update_rate>
    </plugin>
  </gazebo>

  <!-- ============================================================
       2. 关节状态发布插件（仅左右驱动轮，避免固定关节刷屏）
       ============================================================ -->
  <gazebo>
    <plugin name="diy_joint_state" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>${joint_state_update_rate}</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ============================================================
       3. 2D 激光雷达（安装在 laser_link，360° 全向扫描）
       ============================================================ -->
  <gazebo reference="laser_link">
    <sensor type="ray" name="diy_laser">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>${laser_update_rate}</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>${laser_samples}</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592653589793</min_angle>
            <max_angle>3.141592653589793</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>${laser_min_range}</min>
          <max>${laser_max_range}</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>${laser_noise_stddev}</stddev>
        </noise>
      </ray>
      <plugin name="diy_laser_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <!-- 输出到 /scan_raw：scan_filter 过滤车体自遮挡后重发 /scan -->
          <remapping>~/out:=scan_raw</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ============================================================
       4. IMU（安装在 imu_link，底盘几何中心）
       ============================================================ -->
  <gazebo reference="imu_link">
    <sensor type="imu" name="diy_imu">
      <pose>0 0 0 0 0 0</pose>
      <!-- always_on 必须显式置 true（官方示例注明 required），否则不触发更新 -->
      <always_on>true</always_on>
      <update_rate>${imu_update_rate}</update_rate>
      <plugin name="diy_imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=imu</remapping>
        </ros>
        <update_rate>${imu_update_rate}</update_rate>
        <frame_name>imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ============================================================
       5. 接触摩擦
       轮子：高摩擦保证驱动；前万向轮：微小摩擦（mu=0.05，阶段 9 排障
       记录：mu=0 时机器人空闲无偏航约束，ODE 接触抖动使其以 ~2°/min
       持续旋转漂移，每轮导航目标切换后 AMCL 信念-真实偏航失配 → 卡墙；
       0.05 足够阻尼漂移，又远低于"别住"阈值，原地旋转不受影响）。
       kp=1e8/kd=1 为 ODE 默认接触刚度：软接触（1e6）会让车体在碰撞/
       急转时晃动甚至倾覆（阶段 9 排障记录：急转擦墙后机器人侧翻，
       车体灌入激光平面污染地图）。
       ============================================================ -->
  <gazebo reference="left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>100000000.0</kp>
    <kd>1.0</kd>
  </gazebo>
  <gazebo reference="right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>100000000.0</kp>
    <kd>1.0</kd>
  </gazebo>
  <gazebo reference="front_caster_link">
    <mu1>0.05</mu1>
    <mu2>0.05</mu2>
    <kp>100000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <!-- ============================================================
       6. 材质映射（materials.xacro 的 6 种 RGBA → Gazebo 内置材质）
       ============================================================ -->
  <gazebo reference="chassis_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="upper_body_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="left_wheel_link">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="right_wheel_link">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="front_caster_link">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="laser_mount_link">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="laser_link">
    <material>Gazebo/Orange</material>
  </gazebo>
  <gazebo reference="imu_link">
    <material>Gazebo/Red</material>
  </gazebo>

</robot>
