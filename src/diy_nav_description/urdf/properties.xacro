<?xml version="1.0"?>
<!--
  diy_nav_bot / properties.xacro
  ==============================
  集中定义机器人所有关键尺寸、质量与坐标参数（SI 单位：m / kg / rad）。
  所有其他 Xacro 模块引用这些属性，避免在多个文件中散落硬编码数值。

  尺寸设计目标：
    - 室内两轮差速移动机器人
    - 低矮矩形底盘 + 上盖 + 左右驱动轮 + 前方球形万向轮
    - 顶部二维激光雷达（安装于圆柱底座）+ 底盘中心 IMU 盒体

  坐标约定（ROS REP-103）：
    x 前方 / y 左方 / z 上方
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       通用常量
       ============================================================ -->
  <!-- 注：xacro 已内置 pi 常量，无需再次定义。若在其他文件中需要使用
       角度可直接写 ${pi/2} 等。 -->

  <!-- ============================================================
       底盘主体（chassis）
       ============================================================ -->
  <!-- 主底盘长（x）×宽（y）×高（z）；0.45×0.32 对齐规格书 -->
  <xacro:property name="base_length" value="0.45"/>
  <xacro:property name="base_width"  value="0.32"/>
  <xacro:property name="base_height" value="0.12"/>
  <xacro:property name="base_mass"   value="8.0"/>

  <!-- base_link 相对 base_footprint 的抬升高度（底盘几何中心离地）
       = 轮半径 + 底盘底面到轮轴的间隙（此处让底盘底面与轮轴等高，
         即底盘底面离地 = wheel_radius，底盘中心离地 = wheel_radius + base_height/2） -->
  <xacro:property name="base_link_z_offset" value="0.135"/>

  <!-- ============================================================
       底盘上盖（upper body）
       ============================================================ -->
  <xacro:property name="upper_length" value="0.24"/>
  <xacro:property name="upper_width"  value="0.20"/>
  <!-- 上盖高度 0.02：从 0.08 收薄，配合激光底座使扫描平面精确落到 0.23 m
       长宽 0.24×0.20：边缘距中心 0.10~0.12 m，落入激光盲区（过滤阈值 0.16 m）
       内——运动俯仰时上盖边缘不再进入扫描平面（阶段 9 排障记录：
       原 0.38×0.28 上盖边缘 0.14~0.19 m 持续产生自遮挡读数污染地图） -->
  <xacro:property name="upper_height" value="0.02"/>
  <xacro:property name="upper_mass"   value="1.5"/>

  <!-- ============================================================
       驱动轮
       ============================================================ -->
  <xacro:property name="wheel_radius"     value="0.075"/>
  <xacro:property name="wheel_width"      value="0.035"/>
  <xacro:property name="wheel_mass"       value="0.60"/>
  <!-- 左右轮中心距（沿 y 轴）= 0.36：轮外缘 y=0.1975 > 底盘半宽 0.16，
       轮子完整探出底盘侧面，消除埋入底盘的物理隐患 -->
  <xacro:property name="wheel_separation" value="0.36"/>
  <!-- 轮轴沿 x 的偏移 = -0.08（轮线在质心后方 8.2 cm）：
       稳定裕度设计（阶段 9 排障记录）：
       - 0.04 版：质心距轮线 4.2 cm，前翻角 atan(0.042/0.15)≈15.7°——
         实测减速/冲击即前翻（车体入激光平面污染地图、导航时倾覆）
       - 0.08 版：质心距轮线 8.2 cm，前翻角 ≈28.7°，caster 承重 ~30%，
         动态稳定性显著提升；外观上轮子略微后移，仍在底盘下方 -->
  <xacro:property name="wheel_x_offset"   value="-0.08"/>

  <!-- ============================================================
       前万向轮（球体近似）
       ============================================================ -->
  <xacro:property name="caster_radius" value="0.035"/>
  <xacro:property name="caster_mass"   value="0.15"/>
  <!-- caster 相对底盘中心的 x 位置（正值表示前方，规格书要求 front_caster）
       0.19 = 底盘半长 0.225 - caster 半径 0.035：球体前缘与底盘前缘齐平，
       尽量前移以加大与轮线的距离，分担更多车重 -->
  <xacro:property name="caster_x_offset" value="0.19"/>

  <!-- ============================================================
       激光雷达（顶部）
       ============================================================ -->
  <!-- 圆柱底座尺寸 -->
  <xacro:property name="laser_mount_radius" value="0.045"/>
  <!-- 底座高度 0.01：与收薄的上盖配合，使 laser_link 原点离地精确 = 0.23 m -->
  <xacro:property name="laser_mount_height" value="0.01"/>
  <xacro:property name="laser_mount_mass"   value="0.20"/>

  <!-- 激光扫描平面（laser_link 原点）相对地面高度目标 = 0.23 m（规格：约 0.23）
       0.23 = base_link_z_offset (0.135)
            + base_height/2 (0.06) + upper_height (0.02)
            + laser_mount_height (0.01) + laser_link_height/2 (0.005)
       laser_link 位于 laser_mount 顶面上方 -->
  <xacro:property name="laser_link_radius" value="0.030"/>
  <xacro:property name="laser_link_height" value="0.010"/>
  <xacro:property name="laser_link_mass"   value="0.03"/>

  <!-- 上盖顶面高度（相对 base_link 原点） = upper_height/2（上盖中心在上盖底面 + upper_height/2）
       laser_mount 中心位于上盖顶面之上 + laser_mount_height/2 -->

  <!-- ============================================================
       IMU 外观盒
       ============================================================ -->
  <xacro:property name="imu_length" value="0.05"/>
  <xacro:property name="imu_width"  value="0.04"/>
  <xacro:property name="imu_height" value="0.02"/>
  <xacro:property name="imu_mass"   value="0.05"/>

</robot>
