<?xml version="1.0"?>
<!--
  diy_nav_bot / materials.xacro
  ==============================
  预定义机器人各部件的显示颜色（RViz visual material）。
  仅使用纯色 RGBA，不依赖外部纹理或网络模型。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 底盘主蓝色 -->
  <material name="diy_blue">
    <color rgba="0.10 0.35 0.80 1.0"/>
  </material>

  <!-- 上盖深灰色 -->
  <material name="diy_dark">
    <color rgba="0.20 0.20 0.22 1.0"/>
  </material>

  <!-- 通用中性灰 -->
  <material name="diy_gray">
    <color rgba="0.55 0.55 0.55 1.0"/>
  </material>

  <!-- 轮子/万向轮黑色 -->
  <material name="diy_black">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>

  <!-- IMU 亮红色 -->
  <material name="diy_red">
    <color rgba="0.85 0.15 0.15 1.0"/>
  </material>

  <!-- 激光雷达顶部部件（亮橙红，便于识别扫描平面） -->
  <material name="diy_lidar">
    <color rgba="0.95 0.30 0.10 1.0"/>
  </material>

</robot>
